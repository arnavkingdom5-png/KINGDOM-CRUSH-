<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for the WebView itself, AdMob, and the Firebase JS SDK loaded inside c.html -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Kingdom Crush"
        android:theme="@style/Theme.KingdomCrush"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <!-- === AdMob App ID (required by the Mobile Ads SDK to initialize) === -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2082766092953444~4668022214" />

        <!-- Recommended by Google: delay AdMob-driven ad loads until an activity has resumed. -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode"
            android:theme="@style/Theme.KingdomCrush">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Needed so AndroidBridge.shareAchievement() can share the generated PNG
             via a content:// URI (required on modern Android instead of file://). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.kingdom.crush.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
